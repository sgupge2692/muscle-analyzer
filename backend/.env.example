# ────────────────────────────────────────────────
# Muscle Analyzer Backend - 環境変数サンプル
# このファイルをコピーして .env を作成してください
# cp .env.example .env
# ────────────────────────────────────────────────

# 実行環境 (development | production)
# production にすると /docs が無効になり、/health の情報が最小化される
ENV=development

# CORSで許可するオリジン（カンマ区切りで複数指定可）
# 本番: https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:3000

# アップロードできる動画の最大サイズ（MB）
MAX_FILE_SIZE_MB=100

# ポート番号（Railwayは自動設定するので通常は不要）
PORT=8000

# JWT認証設定
# JWT_SECRET は必ず32文字以上のランダム文字列にしてください
# 生成例: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your-super-secret-key-change-this-in-production
JWT_EXPIRE_MIN=60

# ユーザーDBのパス（本番はPostgreSQL等に移行推奨）
USERS_DB_PATH=data/users.json
